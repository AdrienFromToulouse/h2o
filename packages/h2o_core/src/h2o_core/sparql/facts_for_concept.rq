# Every claim about one concept, with its conflict flag in the same row.
#
# Backs get_facts. The flag comes back alongside the value rather than in a
# separate query, so ADR-002's "no consumer can accidentally read one value as
# settled" is a property of the query rather than of the caller's diligence.

PREFIX h2o: <https://vocab.h2o.example/id/>

SELECT ?claim ?predicate ?value ?unit ?source_file ?doc_version ?line_range
       ?snippet ?confidence ?status ?stage ?score ?conflicts_with
WHERE {
  GRAPH <h2o:graph/facts> {
    ?claim h2o:subject    {{concept}} ;
           h2o:predicate  ?predicate ;
           h2o:value      ?value ;
           h2o:sourceFile ?source_file ;
           h2o:docVersion ?doc_version ;
           h2o:lineRange  ?line_range ;
           h2o:snippet    ?snippet ;
           h2o:status     ?status .
    OPTIONAL { ?claim h2o:unit            ?unit }
    OPTIONAL { ?claim h2o:confidence      ?confidence }
    OPTIONAL { ?claim h2o:resolvedBy      ?stage }
    OPTIONAL { ?claim h2o:resolutionScore ?score }
    OPTIONAL { ?claim h2o:conflictsWith   ?conflicts_with }
  }
}
ORDER BY ?predicate ?source_file ?line_range
