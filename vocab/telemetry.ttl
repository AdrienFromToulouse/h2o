@prefix h2o:  <https://vocab.h2o.example/id/> .
@prefix hs:   <https://vocab.h2o.example/scheme/> .
@prefix tel:  <https://vocab.h2o.example/telemetry/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# Telemetry: the machine-side vocabulary, mapped onto the business one.
#
# This scheme is owned by the firmware team and versions on their release
# cycle. It is deliberately SEPARATE from the business schemes so that a
# firmware rename is not a business-vocabulary change, and so that no
# attribute key ever reaches the curation UI.
# See docs/adrs/003-otel-fleet-signals-to-skos.md.
#
# INVENTED FIXTURE DATA. `service.name`, `service.namespace`,
# `deployment.environment`, `device.id` and `device.model.identifier` are real
# OpenTelemetry semantic conventions. Everything below was authored for this
# demonstrator: `component.type`, `water.output`, `fault.code`, `fault.type`,
# `service.type`, the E-codes, and every `dispenser.*` instrument name.
#
# NOTE: there is deliberately NO concept for `fault.type=scale_buildup` or
# `fault.code=E42`. The recorded fixture emits both, they map to nothing, and
# that unmapped signal is what opens the telemetry-driven demonstration loop.

hs:telemetry a skos:ConceptScheme ;
    dct:title       "Telemetry Signals"@en ;
    dct:description "OpenTelemetry attribute values and instrument names emitted by dispenser firmware, aligned to the business vocabulary."@en ;
    dct:creator     "Firmware"@en ;
    skos:hasTopConcept tel:component.type, tel:water.output, tel:fault.type,
                       tel:fault.code, tel:service.type, tel:instrument .

h2o:otelSignal a owl:AnnotationProperty ;
    rdfs:label   "OTEL instrument name"@en ;
    rdfs:comment "The OpenTelemetry instrument or event on which this token appears."@en .

h2o:otelUnit a owl:AnnotationProperty ;
    rdfs:label   "OTEL unit"@en ;
    rdfs:comment "The UCUM unit declared by the instrument."@en .

##  Attribute keys: the top level mirrors the wire structure  ################
#
# Keys carry no mapping. Only the leaf tokens align to business concepts,
# because it is the value that names a thing, not the key.

tel:component.type a skos:Concept ;
    skos:inScheme     hs:telemetry ;
    skos:topConceptOf hs:telemetry ;
    skos:prefLabel    "component.type"@en ;
    skos:definition   "Attribute key identifying which serviceable component a data point concerns."@en ;
    owl:versionInfo   "1" .

tel:water.output a skos:Concept ;
    skos:inScheme     hs:telemetry ;
    skos:topConceptOf hs:telemetry ;
    skos:prefLabel    "water.output"@en ;
    skos:definition   "Attribute key identifying which form of water a dispense data point concerns."@en ;
    owl:versionInfo   "1" .

tel:fault.type a skos:Concept ;
    skos:inScheme     hs:telemetry ;
    skos:topConceptOf hs:telemetry ;
    skos:prefLabel    "fault.type"@en ;
    skos:definition   "Attribute key giving the symbolic class of a reported fault."@en ;
    owl:versionInfo   "1" .

tel:fault.code a skos:Concept ;
    skos:inScheme     hs:telemetry ;
    skos:topConceptOf hs:telemetry ;
    skos:prefLabel    "fault.code"@en ;
    skos:definition   "Attribute key giving the firmware's numeric fault code."@en ;
    owl:versionInfo   "1" .

tel:service.type a skos:Concept ;
    skos:inScheme     hs:telemetry ;
    skos:topConceptOf hs:telemetry ;
    skos:prefLabel    "service.type"@en ;
    skos:definition   "Attribute key giving the class of a recorded service event."@en ;
    owl:versionInfo   "1" .

tel:instrument a skos:Concept ;
    skos:inScheme     hs:telemetry ;
    skos:topConceptOf hs:telemetry ;
    skos:prefLabel    "instrument"@en ;
    skos:definition   "Instrument names that map to a business measure directly, without an attribute."@en ;
    owl:versionInfo   "1" .

##  component.type  ###########################################################

tel:component.type.carbon_filter a skos:Concept ;
    skos:inScheme   hs:telemetry ;
    skos:broader    tel:component.type ;
    skos:prefLabel  "component.type=carbon_filter"@en ;
    skos:notation   "carbon_filter" ;
    h2o:otelSignal  "dispenser.filter.life_remaining" ;
    h2o:otelUnit    "%" ;
    skos:exactMatch h2o:carbon-filter ;
    owl:versionInfo "1" .

tel:component.type.sediment_filter a skos:Concept ;
