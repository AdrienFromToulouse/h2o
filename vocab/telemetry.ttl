##  water.output  #############################################################

tel:water.output.still a skos:Concept ;
    skos:inScheme   hs:telemetry ;
    skos:broader    tel:water.output ;
    skos:prefLabel  "water.output=still"@en ;
    skos:notation   "still" ;
    h2o:otelSignal  "dispenser.water.dispensed" ;
    h2o:otelUnit    "L" ;
    skos:exactMatch h2o:still ;
    owl:versionInfo "1" .

tel:water.output.chilled a skos:Concept ;
    skos:inScheme   hs:telemetry ;
    skos:broader    tel:water.output ;
    skos:prefLabel  "water.output=chilled"@en ;
    skos:notation   "chilled" ;
    h2o:otelSignal  "dispenser.water.dispensed" ;
    h2o:otelUnit    "L" ;
    skos:exactMatch h2o:chilled ;
    owl:versionInfo "1" .

tel:water.output.sparkling a skos:Concept ;
    skos:inScheme   hs:telemetry ;
    skos:broader    tel:water.output ;
    skos:prefLabel  "water.output=sparkling"@en ;
    skos:notation   "sparkling" ;
    h2o:otelSignal  "dispenser.water.dispensed" ;
    h2o:otelUnit    "L" ;
    skos:exactMatch h2o:sparkling ;
