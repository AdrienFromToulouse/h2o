##  fault.type and fault.code  ################################################

tel:fault.type.low_flow a skos:Concept ;
    skos:inScheme   hs:telemetry ;
    skos:broader    tel:fault.type ;
    skos:prefLabel  "fault.type=low_flow"@en ;
    skos:notation   "low_flow" ;
    h2o:otelSignal  "dispenser.fault" ;
    skos:exactMatch h2o:low-flow ;
    owl:versionInfo "1" .

# closeMatch, not exactMatch: the firmware condition is narrower than the
# business term, and saying so is more useful than flattening the difference.
tel:fault.code.E17 a skos:Concept ;
    skos:inScheme   hs:telemetry ;
    skos:broader    tel:fault.code ;
    skos:prefLabel  "fault.code=E17"@en ;
    skos:notation   "E17" ;
    h2o:otelSignal  "dispenser.fault" ;
    skos:closeMatch h2o:low-flow ;
    skos:scopeNote  "Firmware raises E17 below 0.8 L/min; the business term also covers user-reported slow flow with no sensor trigger."@en ;
    owl:versionInfo "1" .

tel:fault.type.no_cooling a skos:Concept ;
    skos:inScheme   hs:telemetry ;
    skos:broader    tel:fault.type ;
    skos:prefLabel  "fault.type=no_cooling"@en ;
    skos:notation   "no_cooling" ;
    h2o:otelSignal  "dispenser.fault" ;
    skos:exactMatch h2o:no-cooling ;
    owl:versionInfo "1" .

tel:fault.code.E23 a skos:Concept ;
    skos:inScheme   hs:telemetry ;
    skos:broader    tel:fault.code ;
    skos:prefLabel  "fault.code=E23"@en ;
    skos:notation   "E23" ;
    h2o:otelSignal  "dispenser.fault" ;
    skos:closeMatch h2o:no-cooling ;
    skos:scopeNote  "Firmware raises E23 when the chiller block fails to reach setpoint within its timeout."@en ;
    owl:versionInfo "1" .

##  service.type  #############################################################

tel:service.type.filter_replacement a skos:Concept ;
    skos:inScheme   hs:telemetry ;
    skos:broader    tel:service.type ;
    skos:prefLabel  "service.type=filter_replacement"@en ;
    skos:notation   "filter_replacement" ;
    h2o:otelSignal  "dispenser.service" ;
    skos:exactMatch h2o:filter-replacement ;
    owl:versionInfo "1" .

##  Instrument names mapped directly  #########################################

tel:instrument.bottles_avoided a skos:Concept ;
    skos:inScheme   hs:telemetry ;
    skos:broader    tel:instrument ;
    skos:prefLabel  "dispenser.bottles_avoided"@en ;
    skos:notation   "dispenser.bottles_avoided" ;
    h2o:otelSignal  "dispenser.bottles_avoided" ;
    h2o:otelUnit    "{bottle}" ;
    skos:exactMatch h2o:single-use-bottles-avoided ;
    owl:versionInfo "1" .

tel:instrument.water_dispensed a skos:Concept ;
    skos:inScheme   hs:telemetry ;
    skos:broader    tel:instrument ;
    skos:prefLabel  "dispenser.water.dispensed"@en ;
    skos:notation   "dispenser.water.dispensed" ;
    h2o:otelSignal  "dispenser.water.dispensed" ;
    h2o:otelUnit    "L" ;
    skos:exactMatch h2o:water-dispensed ;
    owl:versionInfo "1" .

tel:instrument.energy_consumed a skos:Concept ;
    skos:inScheme   hs:telemetry ;
    skos:broader    tel:instrument ;
    skos:prefLabel  "dispenser.energy.consumed"@en ;
    skos:notation   "dispenser.energy.consumed" ;
    h2o:otelSignal  "dispenser.energy.consumed" ;
    h2o:otelUnit    "kW.h" ;
    skos:exactMatch h2o:energy-consumed ;
    owl:versionInfo "1" .
